ECASH_DATA_BASE=./data
PUID=1000
PGID=1000
ENFORCER_RUST_LOG=info
ENFORCER_SYNC_WAIT_SECONDS=300
# Deliberately accept the exact pinned AssumeUTXO state before the independent
# historical replay finishes. loadtxoutset still verifies the compiled UTXO
# commitment; set false to restore the full-history deployment gate.
TRUST_ASSUMEUTXO_SNAPSHOT=true
# A restart can keep RPC in warmup while final UTXO statistics are computed.
# Wait here instead of re-hashing the 9.5 GB snapshot on every service retry.
SNAPSHOT_RPC_WAIT_SECONDS=43200
SNAPSHOT_HEADER_WAIT_SECONDS=1800
BIP300_MONITOR_SIDECHAINS=9,98
BIP300_MONITOR_LOG_LEVEL=info
# Blocks one restart may recover. A longer outage than this is skipped with a
# warning rather than backfilled, so raise it before restarting after one.
BIP300_MONITOR_BACKFILL_MAX_BLOCKS=2000
BIP300_MONITOR_FULL_EVENTS=true
MONITOR_STARTUP_WAIT_SECONDS=60
MONITOR_EVENT_WAIT_SECONDS=60
LIVE_BLOCK_WAIT_SECONDS=3600
LIVE_EVENT_WAIT_SECONDS=60
