ECASH_DATA_BASE=./data
PUID=1000
PGID=1000
ENFORCER_RUST_LOG=info
ENFORCER_SYNC_WAIT_SECONDS=300
# Deliberately accept the exact pinned AssumeUTXO state before the independent
# historical replay finishes. loadtxoutset still verifies the compiled UTXO
# commitment; set false to restore the full-history deployment gate.
TRUST_ASSUMEUTXO_SNAPSHOT=true
# A restart can keep RPC in warmup while final UTXO statistics are computed.
# Wait here instead of re-hashing the 9.5 GB snapshot on every service retry.
SNAPSHOT_RPC_WAIT_SECONDS=43200
SNAPSHOT_HEADER_WAIT_SECONDS=1800
# A pre-activation snapshot still has to download every block body from its
# base through the fork. Do not mistake that normal foreground sync for a
# failed getblockfrompeer request.
SNAPSHOT_ACTIVATION_WAIT_SECONDS=86400
BIP300_MONITOR_LOG_LEVEL=info
# Historical delta pages can take longer than the generic client default while
# the enforcer reads cold state. Keep the deadline bounded but deployment-safe.
BIP300_MONITOR_REQUEST_TIMEOUT_SECONDS=120
# All active slots are discovered automatically. Total history is recovered in
# small pages so neither the enforcer nor the extractor holds it all in memory.
BIP300_MONITOR_BACKFILL_PAGE_BLOCKS=128
BIP300_MONITOR_BACKFILL_PAGE_PAUSE_MS=100
BIP300_MONITOR_TIP_POLL_INTERVAL_SECONDS=30
BIP300_MONITOR_BMM_REQUEST_POLL_INTERVAL_SECONDS=5
BIP300_MONITOR_STREAM_STALL_TIMEOUT_SECONDS=60
BIP300_MONITOR_FULL_EVENTS=true
MONITOR_STARTUP_WAIT_SECONDS=60
MONITOR_EVENT_WAIT_SECONDS=60
# One successful poll is required even when there are no BMM requests. This
# proves that an empty auction is observed data rather than an RPC failure.
BMM_REQUEST_WAIT_SECONDS=30
WORKER_HEALTH_WAIT_SECONDS=60
# Initial full history can take much longer than the semantic snapshot.
HISTORY_WAIT_SECONDS=43200
LIVE_BLOCK_WAIT_SECONDS=3600
LIVE_EVENT_WAIT_SECONDS=60
