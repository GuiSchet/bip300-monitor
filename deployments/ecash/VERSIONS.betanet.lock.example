# Candidate images must be regenerated and verified before deployment.
RELEASE_STATUS=preparing
# shellcheck shell=bash
# Reviewed Betanet lock retained as a promotion/audit reference. The active
# VERSIONS.lock must match these immutable network and artifact values.
LOCK_FORMAT=5
LOCKED_AT=2026-10-05

NETWORK_ID=betanet
ECASH_NODE_CHAIN=main
ECASH_NETWORK_MAGIC=eca5b104
ECASH_NODE_P2P_PORT=8533
ECASH_NODE_RPC_PORT=8532
ECASH_NODE_ZMQ_PORT=29000
ECASH_PUBLIC_PEERS=seed.beta.ecash.ninja:8533,seed.beta.bip300.xyz:8533,seed.beta.ecash.drivecha.in:8533,seed.beta.ecash.zuexeuz.net:8533
ECASH_TIP_HEIGHT_URL=https://esplora.beta.ecash.ninja/blocks/tip/height
ECASH_EXPECTED_DATA_BYTES=1200000000000
ECASH_MIN_FREE_PERCENT=20

# Official Betanet source and image reviewed on 2026-09-22. This build already
# contains Bitcoin Core's height-935000 AssumeUTXO commitment, so no custom
# consensus fork is required.
ECASH_NODE_REPO=https://github.com/ecash-com/bitcoin.git
ECASH_NODE_BRANCH=betanet
ECASH_NODE_COMMIT=ca64033c137457a3c8ca394186759819a2ab0694
ECASH_NODE_IMAGE=ghcr.io/ecash-com/bitcoin:betanet@sha256:b98407f8853d2d7f6c060e6c4b99641402ede40d9227730474bfa2beea239f52
ECASH_NODE_EXPECTED_VERSION=31

ENFORCER_REPO=https://github.com/LayerTwo-Labs/bip300301_enforcer.git
ENFORCER_BRANCH=master
ENFORCER_UPSTREAM_REVIEWED_COMMIT=1753fc0c23863bcb39c681e1cfaea2705613516f
ENFORCER_COMMIT=1753fc0c23863bcb39c681e1cfaea2705613516f
ENFORCER_IMAGE=ghcr.io/guischet/bip300-enforcer-official:sha-1753fc0c2386@sha256:20ee50366ee941731d26a47580481fd88ec2747014bc6cd18628a8844f4154dc
ENFORCER_NETWORK_PRESET=betanet
ENFORCER_API_NETWORK=NETWORK_MAINNET

NATS_IMAGE=docker.io/library/nats:2.14.3-alpine@sha256:c11af972c99ae542de8925e6a7d9c533aa1eb039660420d2074beed6089b3bf0
POSTGRES_IMAGE=docker.io/library/postgres:18.2-alpine@sha256:035b9ab53cfa147d7202b61f5f7782b939ae815b7d6bc81c96b7b42ff1fca950
POSTGRES_DB=bip300_monitor
POSTGRES_USER=bip300_monitor

# Local reviewed release candidate; OCI artifacts must be published before apply.
# Keep contract, source commit, and both immutable image
# digests together.
MONITOR_EVENT_CONTRACT_VERSION=8
MONITOR_IMAGE_COMMIT=ecf5b8290e6b5501508a4a3913bd93c83728cca1
ENFORCER_EXTRACTOR_IMAGE=docker.io/guischet/bip300-enforcer-extractor:sha-ecf5b8290e6b@sha256:e5e1b9fbcaa7a3493cbc25b9efddb9e5f70a52ecddd29b01919760757b9c3bf8
EVENT_LOGGER_IMAGE=docker.io/guischet/bip300-event-logger:sha-ecf5b8290e6b@sha256:e6328fb87385d8b6210999c2d32aed85104520acdd1f60dfc3db338157dca328

JUST_VERSION=1.57.0
JUST_TARGET=x86_64-unknown-linux-musl
JUST_SHA256=45b548094283cb9739af8f13273b8cddeee869f5b4ef2bb631b1f311cb566155

# The official node commits to the Bitcoin height-935000 UTXO set. The UTXO
# contents are shared history, but snapshot format v2 embeds Bitcoin's network
# magic. snapshot.sh verifies the source and rewrites only those four metadata
# bytes before loadtxoutset validates the compiled UTXO commitment.
ECASH_ACTIVATION_HEIGHT=967680
ECASH_ACTIVATION_BLOCK_HASH=00000000000000030101ba5cfea54b22becc79f95dc6040beb76e01dd9d04042
ECASH_SNAPSHOT_HEIGHT=935000
ECASH_SNAPSHOT_BLOCK_HASH=0000000000000000000147034958af1652b2b91bba607beacc5e72a56f0fb5ee
ECASH_SNAPSHOT_TRANSFORM=network_magic_v2
ECASH_SNAPSHOT_URL=https://achow101.com/files/utxo-snapshots/mainnet-935000-utxos.dat
ECASH_SNAPSHOT_MIRROR_URL=https://files-vps02.jaonoctus.dev/utxo-935000.dat
ECASH_SNAPSHOT_SOURCE_FILE=mainnet-935000-utxos.dat
ECASH_SNAPSHOT_SOURCE_SIZE=9387990306
ECASH_SNAPSHOT_SOURCE_SHA256=e572ddbe456d254f05fb004cebe225bdb3656074b66f0e9b1c7fa83e1301d486
ECASH_SNAPSHOT_SOURCE_NETWORK_MAGIC=f9beb4d9
ECASH_SNAPSHOT_FILE=utxo-935000-betanet.dat
ECASH_SNAPSHOT_UTXO_HASH=e4b90ef9eae834f56c4b64d2d50143cee10ad87994c614d7d04125e2a6025050
