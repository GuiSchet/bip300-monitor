set dotenv-load
set shell := ["bash", "-euo", "pipefail", "-c"]

# Show the available deployment commands.
default:
    @just --list

# Create local configuration and persistent directories.
init:
    ./scripts/init.sh

# Check resources, endpoints, images, and network isolation without starting services.
preflight:
    ./scripts/preflight.sh

# Pull and start the pinned eCash node for the locked network.
up:
    ./scripts/up.sh

# Start the enforcer after the eCash node is synchronized.
enforcer-up:
    ./scripts/enforcer-up.sh

# Start NATS, the event logger, and the enforcer extractor in safe order.
monitor-up:
    ./scripts/monitor-up.sh

# Back up and replace only the Postgres record; pass the exact network id.
reset-record confirmation="":
    ./scripts/reset-record.sh "{{ confirmation }}"

# Download, verify, and load the pinned AssumeUTXO snapshot.
snapshot:
    ./scripts/snapshot.sh

# Show container, blockchain, and chainstate status.
status:
    ./scripts/status.sh

# Verify the complete node-to-logger observation pipeline.
verify:
    ./scripts/verify.sh

# Wait for a new block and verify live delivery for every configured slot.
verify-live:
    ./scripts/verify-live.sh

# Run fast and live verification, then write the deployment acceptance marker.
accept:
    ./scripts/accept.sh

# Follow all logs, or only one named service.
logs service="":
    ./scripts/logs.sh "{{ service }}"

# Stop the stack without deleting persistent data.
down:
    ./scripts/down.sh
