# Copy to ~/.config/bip300-monitor/offhost.env (chmod 600). Never commit the copy.
# SSH destination of the monitor VPS, as user@host. Prefer a dedicated,
# unprivileged backup account over root.
BIP300_BACKUP_HOST=backup@monitor.example.invalid
# Absolute path of the private key used only for this pull (systemd does not
# expand ~ or %h inside this file).
BIP300_BACKUP_IDENTITY=/home/operator/.ssh/bip300-backup
