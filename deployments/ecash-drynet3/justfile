set dotenv-load
set shell := ["bash", "-euo", "pipefail", "-c"]

# Show the available deployment commands.
default:
    @just --list

# Create local configuration and persistent directories.
init:
    ./scripts/init.sh

# Pull and start the pinned Drynet3 node.
up:
    ./scripts/up.sh

# Start the enforcer after the Drynet3 node is synchronized.
enforcer-up:
    ./scripts/enforcer-up.sh

# Download, verify, and load the pinned AssumeUTXO snapshot.
snapshot:
    ./scripts/snapshot.sh

# Show container, blockchain, and chainstate status.
status:
    ./scripts/status.sh

# Verify that the node and enforcer agree on the current Drynet3 tip.
verify:
    ./scripts/verify.sh

# Follow all logs, or only one named service.
logs service="":
    ./scripts/logs.sh "{{ service }}"

# Stop the stack without deleting persistent data.
down:
    ./scripts/down.sh
